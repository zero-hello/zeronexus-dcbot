# ==============================================================================
# ZeroNexus (ZN) 核心環境變數配置範本 (.env.example)
# ==============================================================================
# 請將本檔案複製為 .env 並填入相應的金鑰與配置資訊。
# 所有的外部工具與可選 API 均已實作「零金鑰自動降級」，未填寫時系統仍可穩定運作。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Discord 核心配置
# ------------------------------------------------------------------------------
# Discord 機器人 Token (必填)
# 申請：https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# 開發者與管理員 User ID（逗號分隔，享有開發者指令最高權限）
DEV_USERS=1514971711739789352

# ------------------------------------------------------------------------------
# 2. 資料庫與快取配置 (Database & Cache)
# ------------------------------------------------------------------------------
# 資料庫連線字串 (預設使用本機 SQLite，亦支援 PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname)
DATABASE_URL=sqlite+aiosqlite:///data/zeronexus.db

# 快取伺服器 Redis URL (選填，例如 redis://localhost:6379/0；若留空自動啟用記憶體雙模快取)
REDIS_URL=

# ------------------------------------------------------------------------------
# 3. AI 供應商網關金鑰池 (AI Gateway Provider Pool)
# ------------------------------------------------------------------------------
# 【Google Gemini】原生支援多金鑰輪詢池（逗號分隔）
# 申請：https://aistudio.google.com/app/apikey
GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-3.1-flash-lite

# 【DeepSeek】官方 API
# 申請：https://platform.deepseek.com/
DEEPSEEK_API_KEYS=key1,key2
DEEPSEEK_MODEL=deepseek-chat

# 【OpenRouter】多金鑰輪詢與智慧路由
# 申請：https://openrouter.ai/keys
OPENROUTER_API_KEY_1=your_openrouter_key_1
OPENROUTER_API_KEY_2=your_openrouter_key_2
OPENROUTER_API_KEYS=your_openrouter_key_1,your_openrouter_key_2
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_GEN_IMAGE_MODEL=google/gemini-2.5-flash-image

# OpenRouter 0 元免費模型池緊急降級金鑰（100% 嚴格限制免費模型，杜絕任何收費）
OPENROUTER_FALLBACK_API_KEY=sk-or-v1-your_fallback_key_here

# 【Hugging Face】Serverless / Router 推論 API
# 申請：https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_hf_token_here
HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct

# 【Manus AI】自主 Agent 連線
MANUS_API_KEY=your_manus_api_key_here
MANUS_API_KEYS=
MANUS_BASE_URL=https://api.manus.ai/v1
MANUS_MODEL=manus-1.6-lite

# 【Cohere】重排器與生成模型 (選填，未填寫時系統自動優雅降級)
# 申請：https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_API_KEYS=
COHERE_MODEL=command-r-plus-08-2024

# 【Mistral AI】
# 申請：https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_API_KEYS=
MISTRAL_MODEL=mistral-large-latest

# 【Groq LPU】極速超低延遲推論
# 申請：https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 4. 專屬分離核心模型設定 (Specialized Core Models)
# ------------------------------------------------------------------------------
# 1. 一般文字對話模型 (極速直出、超低延遲)
NORMAL_TEXT_MODEL=gemini-3.1-flash-lite

# 2. 視覺多模態分析模型 (當使用者上傳圖片/螢幕截圖/相片時自動調用)
NORMAL_VISION_MODEL=gemini-3.1-flash-lite

# 3. AI 圖像生成模型 (支援 Google 原生 gemini-2.5-flash-image 或 imagen-3.0-generate-002)
NORMAL_GEN_IMAGE_MODEL=gemini-2.5-flash-image

# ------------------------------------------------------------------------------
# 5. 外部真實民生交通與工具 API (External Real Tools)
# ------------------------------------------------------------------------------
# 交通部中央氣象署 Open Data API Key (CWA)
# 申請：https://opendata.cwa.gov.tw/
CWA_API_KEY=your_cwa_api_key

# 交通部 TDX 運輸資料流通服務 (台鐵、高鐵班次時刻表與即時誤點)
# 申請：https://tdx.transportdata.tw/ (選填，未填寫時自動使用免 Key 雙鐵時刻端點)
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 財政部電子發票整合服務平台 API (統一發票開獎號碼與兌獎期限)
# 申請：https://www.einvoice.nat.gov.tw/ (選填，未填寫時自動使用財政部稅務入口網公開端點)
EINVOICE_APP_ID=

# 環境部空氣品質開放資料 API Key (選填，未填寫時自動啟用 Open-Meteo 免費端點)
# 申請：https://data.moenv.gov.tw/
MOENV_API_KEY=

# 美股即時報價 Finnhub API Key (選填，未填寫時自動啟用 Yahoo Finance 免費即時行情)
# 申請：https://finnhub.io/
FINNHUB_API_KEY=

# 加密貨幣即時報價 CoinGecko API Key (選填，未填寫時自動使用幣安 Binance 即時端點)
# 申請：https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# 國際外幣即時匯率 ExchangeRate-API Key (選填，未填寫時自動使用歐洲央行 Frankfurter 免費端點)
# 申請：https://www.exchangerate-api.com/
EXCHANGERATE_API_KEY=

# IP 歸屬地查詢 IPInfo Token (選填，未填寫時自動使用 ip-api.com 免費端點)
# 申請：https://ipinfo.io/
IPINFO_TOKEN=

# Google 官方 API 套件 (Google Official API Suite - 選填)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
YOUTUBE_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_BOOKS_API_KEY=

# ------------------------------------------------------------------------------
# 6. 音訊串流節點 (Audio Stream / Music)
# ------------------------------------------------------------------------------
AudioStream_HOST=AudioStream.jirayu.net
AudioStream_PORT=443
AudioStream_PASSWORD=youshallnotpass
AudioStream_SECURE=true
AudioStream_IDENTIFIER=jirayu-ssl

# ------------------------------------------------------------------------------
# 7. 系統全域時區設定 (System & Timezone)
# ------------------------------------------------------------------------------
TZ=Asia/Taipei
